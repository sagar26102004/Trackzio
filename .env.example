# ---- Backend (server/.env) ----------------------------------------------

# TMDB API Read Access Token (v4 JWT) from https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=

# Postgres (Supabase).
# Dashboard -> your project -> Connect -> ORM -> Prisma gives both of these.
#
#   DATABASE_URL  Transaction pooler, port 6543. Used at runtime. The
#                 ?pgbouncer=true flag is REQUIRED: it tells Prisma to stop using
#                 prepared statements, which a transaction-mode pooler cannot
#                 support. connection_limit caps our slice of the connection pool.
#
#   DIRECT_URL    Session pooler, port 5432. Used only by `prisma migrate`, which
#                 needs a real session for advisory locks and DDL.
#
# Both use the pooler host rather than db.<ref>.supabase.co, because the direct
# host is IPv6-only and many home/CI networks cannot reach it.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Secret used to sign the anonymous device cookie. Any long random string.
SESSION_SECRET=change-me-to-a-long-random-string

PORT=4000
NODE_ENV=development

# Exact origin(s) of the frontend, comma-separated. Required for cookie auth.
# In production this is your Vercel URL. With the /api rewrite in place the browser
# never makes a cross-origin call, but this still guards direct access to the API.
CORS_ORIGIN=http://localhost:5173

# 'lax' whenever the SPA reaches the API on its own origin - true locally, and true
# in production thanks to the Vercel rewrite. Only use 'none' for a genuinely
# cross-site deployment, which Safari and Brave will break.
COOKIE_SAMESITE=lax

# Proxy hops in front of the app. Decides what req.ip resolves to, which the login
# rate limiter counts against. 1 locally or behind Render alone; 2 behind Vercel's
# rewrite in front of Render.
TRUST_PROXY=1

# ---- Local Postgres alternative -----------------------------------------
# To run entirely offline instead, `docker compose up -d` and use:
#   DATABASE_URL=postgresql://trackzio:trackzio@localhost:5433/trackzio?schema=public
#   DIRECT_URL=postgresql://trackzio:trackzio@localhost:5433/trackzio?schema=public

# ---- Frontend (web/.env) ------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000
